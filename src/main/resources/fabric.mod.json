{
  "schemaVersion": 1,
  "id": "carpetutility",
  "version": "${version}",
  "name": "CarpetUtility",
  "description": "Fabric mod for Carpet fake player pathfinding, bridging, mining through walls, pillaring, cobweb scoreboard tracking, and bot name generator.",
  "authors": [
    "Mhdajt",
    "Fins",
    "SR888V"
  ],
  "contact": {
    "sources": "https://github.com/Mhdajt/carpetutility"
  },
  "license": "MIT",
  "icon": "assets/carpetutility/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.carpetutility.CarpetUtilityMod"
    ]
  },
  "mixins": [
    "carpetutility.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "carpet": "*"
